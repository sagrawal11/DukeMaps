{
  "name": "dukemaps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Walking-directions web app for Duke's campus that shows routing algorithms at work.",
  "scripts": {
    "dev": "vite",
    "editor": "vite --open /editor/",
    "bbox": "vite --open /editor/bbox.html",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch": "tsx scripts/fetch.ts",
    "build:graph": "tsx scripts/build-graph.ts",
    "build:crowding": "tsx scripts/build-crowding.ts",
    "build:ch": "tsx scripts/build-ch.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:algo": "tsx scripts/bench-algorithms.ts",
    "bench:ch": "tsx scripts/bench-ch.ts",
    "fetch:basemap": "tsx scripts/fetch-basemap.ts",
    "rebuild": "npm run fetch && npm run build:graph && npm run build:crowding && npm run build:ch",
    "deploy": "node -e \"console.log('deploy: wired to a GitHub Pages Action in Phase 7')\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "protomaps-themes-base": "^4.5.0"
  }
}
